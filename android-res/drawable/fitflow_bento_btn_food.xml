<!-- 0.9.30: круглая кнопка быстрого ввода в плите питания.
     Тот же размер, что у кнопки воды (38 dp) — на скрине 0.9.29
     карандаш зрительно раздувал круг, хотя размер был общий.
     Цвет приглушён на две ступени против 0.9.29: владелец просил, чтобы
     кнопка не выжигала правый край виджета. Оттенок остаётся оранжевым —
     это цвет показателя, кнопка не должна выглядеть «второй водой». -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="oval">
    <solid android:color="#D9714A"/>
    <size android:width="38dp" android:height="38dp"/>
