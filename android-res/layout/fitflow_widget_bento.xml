<?xml version="1.0" encoding="utf-8"?>
<!-- 0.9.28: подложка PNG (только оболочка и плиты) + полный overlay.

     Сетка ОБЯЗАНА совпадать с tools/prepare-bento-bg.py:
       поле 36/1200 = 3 %, промежуток 30/1200 = 2.5 %,
       левая плита 538/1200, правая колонка 560/1200,
       в правой колонке две плиты по (542-30)/2.
     Поэтому здесь всё на layout_weight, а не в фиксированных dp:
     подложка тянется fitXY, и только проценты дают совпадение
     содержимого с плитами на любом размере ячейки.

     Слоты обезличены (A — крупный с кольцом, B и C — со шкалой):
     какой показатель в каком слоте, решает FitFlowWidgetBentoProvider
     по выбору пользователя. Подписей в картинке больше нет.

     ВНИМАНИЕ (0.9.29, полевой отказ «Не удалось добавить виджет»):
     здесь можно использовать ТОЛЬКО вьюхи из белого списка RemoteViews —
     FrameLayout, LinearLayout, RelativeLayout, GridLayout, TextView,
     ImageView, ImageButton, Button, ProgressBar, Chronometer, AnalogClock,
     ViewFlipper, ListView, GridView, StackView, AdapterViewFlipper,
     ViewStub. Обычный <View> в этот список НЕ входит: лаунчер не может
     раздуть разметку и виджет не добавляется на экран вообще (чёрный
     прямоугольник с ошибкой). Поэтому все распорки — пустые FrameLayout.
     Сторож — тест «0.9.29 ... белого списка RemoteViews».
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_bento_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <ImageView
        android:id="@+id/widget_bento_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bento_bg"
        android:contentDescription="@null" />

    <!-- Внешнее поле 3 % — ровно PAD подложки. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:weightSum="1000">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="59" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="882"
            android:orientation="horizontal"
            android:weightSum="1000">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="30" />

            <!-- ===== Слот A: крупный, кольцо + иконка ===== -->
            <FrameLayout
                android:id="@+id/widget_bento_a_card"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="448">

                <TextView
                    android:id="@+id/widget_bento_a_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="14dp"
                    android:layout_marginTop="10dp"
                    android:text=""
                    android:textColor="#98A0AE"
                    android:textSize="12sp"
                    android:textStyle="normal"
                    android:fontFamily="sans-serif"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <!-- Кольцо и иконка — в одном центрированном контейнере,
                     поэтому иконка всегда ровно в середине кольца.
                     В 0.9.27 кольцо рисовал overlay, а кроссовок лежал
                     в картинке: центры не совпадали ни на одном размере,
                     мысок наступал на дугу (полевой дефект). -->
                <FrameLayout
                    android:id="@+id/widget_bento_a_ringbox"
                    android:layout_width="104dp"
                    android:layout_height="104dp"
                    android:layout_gravity="center"
                    android:layout_marginBottom="20dp">

                    <!-- Кольца по одному на показатель — причина та же, что у шкал. -->
                    <ProgressBar
                        android:id="@+id/widget_bento_a_ring_water"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:max="100"
                        android:progress="0"
                        android:indeterminate="false"
                        android:visibility="gone"
                        android:progressDrawable="@drawable/fitflow_bento_ring_water" />

                    <ProgressBar
                        android:id="@+id/widget_bento_a_ring_food"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:max="100"
                        android:progress="0"
                        android:indeterminate="false"
                        android:visibility="gone"
                        android:progressDrawable="@drawable/fitflow_bento_ring_food" />

                    <ProgressBar
                        android:id="@+id/widget_bento_a_ring_activity"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:max="100"
                        android:progress="0"
                        android:indeterminate="false"
                        android:visibility="gone"
                        android:progressDrawable="@drawable/fitflow_bento_ring_activity" />

                    <ProgressBar
                        android:id="@+id/widget_bento_a_ring_steps"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:max="100"
                        android:progress="0"
                        android:indeterminate="false"
                        android:visibility="gone"
                        android:progressDrawable="@drawable/fitflow_bento_ring" />


                    <ImageView
                        android:id="@+id/widget_bento_a_icon"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_gravity="center"
                        android:scaleType="fitCenter"
                        android:src="@drawable/widget_bento_shoe"
                        android:contentDescription="@null" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingBottom="10dp">

                    <!-- Значение и цель — ДВЕ строки. Тот же приём во всех
                         трёх плитах (просьба владельца о едином подходе).
                         Одной строкой не делаем: «1 000 из 2 300 мл» рядом
                         с круглой кнопкой не помещается по ширине и цель
                         обрезается многоточием — проверено предпросмотром
                         tools/widget-bento-preview.py. -->
                    <TextView
                        android:id="@+id/widget_bento_a_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif"
                        android:includeFontPadding="false"
                        android:maxLines="1" />

                    <TextView
                        android:id="@+id/widget_bento_a_goal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="#98A0AE"
                        android:textSize="11sp"
                        android:textStyle="normal"
                        android:fontFamily="sans-serif"
                        android:includeFontPadding="false"
                        android:maxLines="1" />
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="25" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="467"
                android:orientation="vertical"
                android:weightSum="1000">

                <!-- ===== Слот B ===== -->
                <FrameLayout
                    android:id="@+id/widget_bento_b_card"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="472">

                    <!-- Текст и шкала. Кнопка лежит поверх справа, поэтому
                         тексту отдан правый отступ 60dp — иначе длинное
                         число заезжало бы под круг. -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:paddingStart="14dp"
                        android:paddingEnd="56dp"
                        android:paddingTop="7dp"
                        android:paddingBottom="8dp">

                        <TextView
                            android:id="@+id/widget_bento_b_label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="#98A0AE"
                            android:textSize="12sp"
                            android:textStyle="normal"
                            android:fontFamily="sans-serif"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:ellipsize="end" />

                        <TextView
                            android:id="@+id/widget_bento_b_value"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:text="0"
                            android:textColor="#FFFFFF"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:ellipsize="end" />

                        <TextView
                            android:id="@+id/widget_bento_b_goal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="#98A0AE"
                            android:textSize="11sp"
                            android:textStyle="normal"
                            android:fontFamily="sans-serif"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:ellipsize="end" />

                        <!-- Распорка (пустой FrameLayout, а не <View> — см.
                             шапку файла) забирает остаток высоты, поэтому
                             шкала всегда прижата к низу и НИКОГДА не срезается.
                             В 0.9.27 шкала была последней в стопке с
                             фиксированными отступами: на невысокой ячейке
                             колонка не помещалась, и у пилюли обрезало
                             нижнее закругление (полевой дефект). -->
                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:minHeight="4dp" />

                        <!-- Четыре шкалы одна поверх другой, по одной на показатель.
                             RemoteViews на minSdk 26 не умеет менять progressDrawable
                             у ProgressBar, а цвет обязан следовать показателю —
                             поэтому провайдер показывает нужную и прячет остальные. -->
                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="10dp">

                            <ProgressBar
                                android:id="@+id/widget_bento_b_bar_water"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:max="100"
                                android:progress="0"
                                android:visibility="gone"
                                android:progressDrawable="@drawable/fitflow_bento_bar_water" />

                            <ProgressBar
                                android:id="@+id/widget_bento_b_bar_food"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:max="100"
                                android:progress="0"
                                android:visibility="gone"
                                android:progressDrawable="@drawable/fitflow_bento_bar_food" />

                            <ProgressBar
                                android:id="@+id/widget_bento_b_bar_activity"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:max="100"
                                android:progress="0"
                                android:visibility="gone"
                                android:progressDrawable="@drawable/fitflow_bento_bar_activity" />

                            <ProgressBar
                                android:id="@+id/widget_bento_b_bar_steps"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:max="100"
                                android:progress="0"
                                android:visibility="gone"
                                android:progressDrawable="@drawable/fitflow_bento_bar_steps" />

                        </FrameLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/widget_bento_b_btn"
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/fitflow_bento_btn"
                        android:gravity="center"
                        android:text=""
                        android:textColor="#082028"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif"
                        android:includeFontPadding="false"
                        android:lineSpacingExtra="0dp"
                        android:maxLines="2"
                        android:visibility="gone" />

                    <ImageView
                        android:id="@+id/widget_bento_b_btn_icon"
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/fitflow_bento_btn"
                        android:padding="13dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/widget_bento_ic_pencil"
                        android:visibility="gone"
                        android:contentDescription="@null" />
                </FrameLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="56" />

                <!-- ===== Слот C ===== -->
                <FrameLayout
                    android:id="@+id/widget_bento_c_card"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="472">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:paddingStart="14dp"
                        android:paddingEnd="56dp"
                        android:paddingTop="7dp"
                        android:paddingBottom="8dp">

                        <TextView
                            android:id="@+id/widget_bento_c_label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="#98A0AE"
                            android:textSize="12sp"
                            android:textStyle="normal"
                            android:fontFamily="sans-serif"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:ellipsize="end" />

                        <TextView
                            android:id="@+id/widget_bento_c_value"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:text="0"
                            android:textColor="#FFFFFF"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:ellipsize="end" />

                        <TextView
                            android:id="@+id/widget_bento_c_goal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="#98A0AE"
                            android:textSize="11sp"
                            android:textStyle="normal"
                            android:fontFamily="sans-serif"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:ellipsize="end" />

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:minHeight="4dp" />

                        <!-- Четыре шкалы одна поверх другой, по одной на показатель.
                             RemoteViews на minSdk 26 не умеет менять progressDrawable
                             у ProgressBar, а цвет обязан следовать показателю —
                             поэтому провайдер показывает нужную и прячет остальные. -->
                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="10dp">

                            <ProgressBar
                                android:id="@+id/widget_bento_c_bar_water"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:max="100"
                                android:progress="0"
                                android:visibility="gone"
                                android:progressDrawable="@drawable/fitflow_bento_bar_water" />

                            <ProgressBar
                                android:id="@+id/widget_bento_c_bar_food"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:max="100"
                                android:progress="0"
                                android:visibility="gone"
                                android:progressDrawable="@drawable/fitflow_bento_bar_food" />

                            <ProgressBar
                                android:id="@+id/widget_bento_c_bar_activity"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:max="100"
                                android:progress="0"
                                android:visibility="gone"
                                android:progressDrawable="@drawable/fitflow_bento_bar_activity" />

                            <ProgressBar
                                android:id="@+id/widget_bento_c_bar_steps"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:max="100"
                                android:progress="0"
                                android:visibility="gone"
                                android:progressDrawable="@drawable/fitflow_bento_bar_steps" />

                        </FrameLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/widget_bento_c_btn"
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/fitflow_bento_btn"
                        android:gravity="center"
                        android:text=""
                        android:textColor="#082028"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif"
                        android:includeFontPadding="false"
                        android:lineSpacingExtra="0dp"
                        android:maxLines="2"
                        android:visibility="gone" />

                    <ImageView
                        android:id="@+id/widget_bento_c_btn_icon"
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/fitflow_bento_btn_food"
                        android:padding="13dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/widget_bento_ic_pencil"
                        android:visibility="gone"
                        android:contentDescription="@null" />
                </FrameLayout>
            </LinearLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="30" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="59" />
    </LinearLayout>
</FrameLayout>
