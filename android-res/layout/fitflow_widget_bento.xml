<?xml version="1.0" encoding="utf-8"?>
<!-- 0.9.31: бенто 4x2 (компактная раскладка).

     Подложка PNG несёт ТОЛЬКО оболочку и три плиты, всё содержимое
     рисует overlay. Сетка ОБЯЗАНА совпадать с tools/prepare-bento-bg.py:
       холст 1200x540, поле по бокам 36, поле сверху/снизу 14,
       промежуток колонок 30, промежуток плит по вертикали 20,
       левая плита 538, правая колонка 560.
     Отсюда веса: по вертикали 26/948/26, по горизонтали
     30/448/25/467/30, в правой колонке 480/40/480.
     Всё на layout_weight, а не в фиксированных dp: подложка тянется
     fitXY, и только проценты дают совпадение содержимого с плитами
     на любом размере ячейки.

     Что изменилось против 0.9.29 (замечания владельца по скрину):

     1. Круглые кнопки уехали в правый верхний угол плит и уменьшены
        46 -> 38 dp. Раньше кнопка стояла по центру плиты и делила
        высоту с текстом: под текстом оставалась пустота, а полоса
        прогресса жалась к самому низу. Теперь кнопка никому не мешает,
        а полоса лежит во всю ширину плиты.
     2. Кнопка питания стала того же размера, что и кнопка воды (38 dp
        обе, раньше разницы не было, но карандаш зрительно раздувал
        круг), и её цвет приглушён: #FF8A5C -> #E0794F.
     3. В углу крупной плиты — шестерёнка: открывает настройки состава
        виджета в приложении.

     Шрифты и их расположение владелец просил не трогать — размеры
     подписей, значений и целей те же, что в 0.9.29. Высота отыграна
     только на воздухе: поля подложки, положение кнопок, кольцо 104 ->
     80 dp.

     ВНИМАНИЕ: здесь можно использовать ТОЛЬКО вьюхи из белого списка
     RemoteViews — FrameLayout, LinearLayout, RelativeLayout, GridLayout,
     TextView, ImageView, ImageButton, Button, ProgressBar, Chronometer,
     AnalogClock, ViewFlipper, ListView, GridView, StackView,
     AdapterViewFlipper, ViewStub. Обычный <View> в этот список НЕ входит:
     лаунчер не может раздуть разметку и виджет не добавляется на экран
     вообще (чёрный прямоугольник с ошибкой, 0.9.29). Поэтому все
     распорки — пустые FrameLayout. Сторож — тест
     «0.9.29 ... белого списка RemoteViews».
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_bento_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <ImageView
        android:id="@+id/widget_bento_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bento_bg"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:weightSum="1000">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="26" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="948"
            android:orientation="horizontal"
            android:weightSum="1000">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="30" />

            <!-- ===== Слот A: крупный, кольцо + иконка ===== -->
            <FrameLayout
                android:id="@+id/widget_bento_a_card"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="448">

                <TextView
                    android:id="@+id/widget_bento_a_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="14dp"
                    android:layout_marginTop="8dp"
                    android:text=""
                    android:textColor="#98A0AE"
                    android:textSize="12sp"
                    android:textStyle="normal"
                    android:fontFamily="sans-serif"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <!-- 0.9.30 (пункт 3 владельца): шестерёнка в правом верхнем
                     углу крупной плиты — короткий путь «сменить показатели
                     виджета». Серая и мелкая намеренно: служебная кнопка не
                     должна спорить с показателями. Область нажатия шире самой
                     картинки за счёт padding — 18 dp иконки в 30 dp кнопке. -->
                <ImageView
                    android:id="@+id/widget_bento_gear"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="2dp"
                    android:layout_marginEnd="2dp"
                    android:padding="5dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/widget_bento_ic_gear"
                    android:alpha="0.55"
                    android:contentDescription="@null" />

                <!-- Кольцо и иконка — в одном центрированном контейнере,
                     поэтому иконка всегда ровно в середине кольца.
                     В 0.9.27 кольцо рисовал overlay, а кроссовок лежал
                     в картинке: центры не совпадали ни на одном размере,
                     мысок наступал на дугу (полевой дефект).
                     0.9.31: кольцо ровно посередине между подписью «Шаги»
                     и числом — на скрине 0.9.30 оно стояло заметно выше.

                     Грабля, из-за которой это вышло: при layout_gravity=
                     "center" отступ marginBottom сдвигает вьюху вверх на
                     ВСЮ свою величину, а не на половину. Стояло 26 dp —
                     кольцо уехало на 26 dp вместо ожидаемых 13.

                     Считается так (ячейка 150 dp, плите достаётся 142.2):
                       подпись занимает сверху   0 .. 21.9 dp
                       «значение + цель» снизу  96.2 .. 142.2 dp
                       свободное поле           21.9 .. 96.2, середина 59.1
                       центр плиты              71.1
                       marginBottom = 71.1 - 59.1 = 12 dp
                     Кольцо 70 dp ложится в 24.1..94.1: зазор до подписи и
                     до числа одинаковый, по 2.2 dp. -->
                <FrameLayout
                    android:id="@+id/widget_bento_a_ringbox"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:layout_gravity="center"
                    android:layout_marginBottom="12dp">

                    <!-- Кольца по одному на показатель — причина та же, что у шкал. -->
                    <ProgressBar
                        android:id="@+id/widget_bento_a_ring_water"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:max="100"
                        android:progress="0"
                        android:indeterminate="false"
                        android:visibility="gone"
                        android:progressDrawable="@drawable/fitflow_bento_ring_water" />

                    <ProgressBar
                        android:id="@+id/widget_bento_a_ring_food"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:max="100"
                        android:progress="0"
                        android:indeterminate="false"
                        android:visibility="gone"
                        android:progressDrawable="@drawable/fitflow_bento_ring_food" />

                    <ProgressBar
                        android:id="@+id/widget_bento_a_ring_activity"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:max="100"
                        android:progress="0"
                        android:indeterminate="false"
                        android:visibility="gone"
                        android:progressDrawable="@drawable/fitflow_bento_ring_activity" />

                    <ProgressBar
                        android:id="@+id/widget_bento_a_ring_steps"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:max="100"
                        android:progress="0"
                        android:indeterminate="false"
                        android:visibility="gone"
                        android:progressDrawable="@drawable/fitflow_bento_ring" />

                    <ImageView
                        android:id="@+id/widget_bento_a_icon"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center"
                        android:scaleType="fitCenter"
                        android:src="@drawable/widget_bento_shoe"
                        android:contentDescription="@null" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingBottom="8dp">

                    <!-- Значение и цель — ДВЕ строки. Тот же приём во всех
                         трёх плитах (просьба владельца о едином подходе).
                         Одной строкой не делаем: «1 000 из 2 300 мл» рядом
                         с круглой кнопкой не помещается по ширине и цель
                         обрезается многоточием — проверено предпросмотром
                         tools/widget-bento-preview.py. -->
                    <TextView
                        android:id="@+id/widget_bento_a_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif"
                        android:includeFontPadding="false"
                        android:maxLines="1" />

                    <TextView
                        android:id="@+id/widget_bento_a_goal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text=""
                        android:textColor="#98A0AE"
                        android:textSize="11sp"
                        android:textStyle="normal"
                        android:fontFamily="sans-serif"
                        android:includeFontPadding="false"
                        android:maxLines="1" />
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="25" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="467"
                android:orientation="vertical"
                android:weightSum="1000">

                <!-- ===== Слот B ===== -->
                <FrameLayout
                    android:id="@+id/widget_bento_b_card"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="480">

                    <!-- Текстовая колонка. paddingEnd 46dp — коридор под
                         круглую кнопку в верхнем углу; paddingBottom 17dp —
                         место под полосу, которая лежит отдельным слоем
                         во всю ширину плиты.
                         Цель растянута (weight=1, height=0dp) нарочно: если
                         лаунчер выдаст плиту ниже расчётной, лишнее съест
                         именно она, а полоса прогресса сохранит свои 10 dp
                         и не окажется срезанной — полевой дефект 0.9.27. -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:paddingStart="14dp"
                        android:paddingEnd="46dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="16dp">

                        <TextView
                            android:id="@+id/widget_bento_b_label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="#98A0AE"
                            android:textSize="12sp"
                            android:textStyle="normal"
                            android:fontFamily="sans-serif"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:ellipsize="end" />

                        <TextView
                            android:id="@+id/widget_bento_b_value"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:text="0"
                            android:textColor="#FFFFFF"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:ellipsize="end" />

                        <TextView
                            android:id="@+id/widget_bento_b_goal"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:text=""
                            android:textColor="#98A0AE"
                            android:textSize="11sp"
                            android:textStyle="normal"
                            android:fontFamily="sans-serif"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:ellipsize="end" />
                    </LinearLayout>

                    <!-- Четыре шкалы одна поверх другой, по одной на показатель.
                         RemoteViews на minSdk 26 не умеет менять progressDrawable
                         у ProgressBar, а цвет обязан следовать показателю —
                         поэтому провайдер показывает нужную и прячет остальные. -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="10dp"
                        android:layout_gravity="bottom"
                        android:layout_marginStart="14dp"
                        android:layout_marginEnd="14dp"
                        android:layout_marginBottom="5dp">

                        <ProgressBar
                            android:id="@+id/widget_bento_b_bar_water"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:max="100"
                            android:progress="0"
                            android:visibility="gone"
                            android:progressDrawable="@drawable/fitflow_bento_bar_water" />

                        <ProgressBar
                            android:id="@+id/widget_bento_b_bar_food"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:max="100"
                            android:progress="0"
                            android:visibility="gone"
                            android:progressDrawable="@drawable/fitflow_bento_bar_food" />

                        <ProgressBar
                            android:id="@+id/widget_bento_b_bar_activity"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:max="100"
                            android:progress="0"
                            android:visibility="gone"
                            android:progressDrawable="@drawable/fitflow_bento_bar_activity" />

                        <ProgressBar
                            android:id="@+id/widget_bento_b_bar_steps"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:max="100"
                            android:progress="0"
                            android:visibility="gone"
                            android:progressDrawable="@drawable/fitflow_bento_bar_steps" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/widget_bento_b_btn"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="6dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/fitflow_bento_btn"
                        android:gravity="center"
                        android:text=""
                        android:textColor="#082028"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif"
                        android:includeFontPadding="false"
                        android:lineSpacingExtra="0dp"
                        android:maxLines="2"
                        android:visibility="gone" />

                    <ImageView
                        android:id="@+id/widget_bento_b_btn_icon"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="6dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/fitflow_bento_btn_food"
                        android:padding="11dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/widget_bento_ic_pencil"
                        android:visibility="gone"
                        android:contentDescription="@null" />
                </FrameLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="40" />

                <!-- ===== Слот C ===== -->
                <FrameLayout
                    android:id="@+id/widget_bento_c_card"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="480">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:paddingStart="14dp"
                        android:paddingEnd="46dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="16dp">

                        <TextView
                            android:id="@+id/widget_bento_c_label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="#98A0AE"
                            android:textSize="12sp"
                            android:textStyle="normal"
                            android:fontFamily="sans-serif"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:ellipsize="end" />

                        <TextView
                            android:id="@+id/widget_bento_c_value"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:text="0"
                            android:textColor="#FFFFFF"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:ellipsize="end" />

                        <TextView
                            android:id="@+id/widget_bento_c_goal"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:text=""
                            android:textColor="#98A0AE"
                            android:textSize="11sp"
                            android:textStyle="normal"
                            android:fontFamily="sans-serif"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:ellipsize="end" />
                    </LinearLayout>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="10dp"
                        android:layout_gravity="bottom"
                        android:layout_marginStart="14dp"
                        android:layout_marginEnd="14dp"
                        android:layout_marginBottom="5dp">

                        <ProgressBar
                            android:id="@+id/widget_bento_c_bar_water"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:max="100"
                            android:progress="0"
                            android:visibility="gone"
                            android:progressDrawable="@drawable/fitflow_bento_bar_water" />

                        <ProgressBar
                            android:id="@+id/widget_bento_c_bar_food"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:max="100"
                            android:progress="0"
                            android:visibility="gone"
                            android:progressDrawable="@drawable/fitflow_bento_bar_food" />

                        <ProgressBar
                            android:id="@+id/widget_bento_c_bar_activity"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:max="100"
                            android:progress="0"
                            android:visibility="gone"
                            android:progressDrawable="@drawable/fitflow_bento_bar_activity" />

                        <ProgressBar
                            android:id="@+id/widget_bento_c_bar_steps"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:max="100"
                            android:progress="0"
                            android:visibility="gone"
                            android:progressDrawable="@drawable/fitflow_bento_bar_steps" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/widget_bento_c_btn"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="6dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/fitflow_bento_btn"
                        android:gravity="center"
                        android:text=""
                        android:textColor="#082028"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif"
                        android:includeFontPadding="false"
                        android:lineSpacingExtra="0dp"
                        android:maxLines="2"
                        android:visibility="gone" />

                    <ImageView
                        android:id="@+id/widget_bento_c_btn_icon"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="6dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/fitflow_bento_btn_food"
                        android:padding="11dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/widget_bento_ic_pencil"
                        android:visibility="gone"
                        android:contentDescription="@null" />
                </FrameLayout>
            </LinearLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="30" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="26" />
    </LinearLayout>
</FrameLayout>
