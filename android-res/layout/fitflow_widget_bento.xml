<?xml version="1.0" encoding="utf-8"?>
<!-- 0.9.26: подложка PNG + живые цифры/полосы/кнопка. Заголовки «Вода»,
     «Калории», кроссовок и круг «+250» нарисованы на фоне. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_bento_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <ImageView
        android:id="@+id/widget_bento_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bento_bg"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:weightSum="100">

        <FrameLayout
            android:id="@+id/widget_bento_steps_card"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="48"
            android:layout_marginEnd="6dp">

            <TextView
                android:id="@+id/widget_bento_steps_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_marginStart="12dp"
                android:layout_marginTop="8dp"
                android:text="Шаги"
                android:textColor="#8E95A2"
                android:textSize="12sp"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingBottom="12dp">

                <TextView
                    android:id="@+id/widget_bento_steps_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/widget_bento_steps_goal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="из 0"
                    android:textColor="#8E95A2"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif"
                    android:includeFontPadding="false"
                    android:maxLines="1" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="52"
            android:orientation="vertical"
            android:weightSum="100">

            <FrameLayout
                android:id="@+id/widget_bento_water_card"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="50">

                <TextView
                    android:id="@+id/widget_bento_water_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="14dp"
                    android:layout_marginTop="28dp"
                    android:layout_marginEnd="58dp"
                    android:text="0 / 0 мл"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <ProgressBar
                    android:id="@+id/widget_bento_water_bar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="62dp"
                    android:layout_marginTop="10dp"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/fitflow_bento_bar_water" />

                <ImageButton
                    android:id="@+id/widget_bento_water_btn"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="10dp"
                    android:background="@android:color/transparent"
                    android:src="@drawable/fitflow_bento_hit"
                    android:contentDescription="+250 мл"
                    android:padding="0dp"
                    android:scaleType="fitXY" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/widget_bento_food_card"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="50">

                <TextView
                    android:id="@+id/widget_bento_food_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="14dp"
                    android:layout_marginTop="32dp"
                    android:layout_marginEnd="14dp"
                    android:text="0 / 0 ккал"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <ProgressBar
                    android:id="@+id/widget_bento_food_bar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_gravity="bottom"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="14dp"
                    android:layout_marginBottom="18dp"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/fitflow_bento_bar_food" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
