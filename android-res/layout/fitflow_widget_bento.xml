<?xml version="1.0" encoding="utf-8"?>
<!-- 0.9.28: подложка PNG + overlay. Заголовки «Шаги» / «Вода» / «Калории» —
     живые TextView единым стилем (#8E95A2, без bold): цифры не наезжают на
     заголовок ни на каком экране. Кроссовок — отдельный PNG в одном
     FrameLayout с кольцом (layout_gravity="center"), поэтому всегда точно
     в центре. Оба правых блока зеркальны: заголовок → число → «из …» →
     полоса; справа круглая кнопка (+250 мл у воды, карандаш у калорий).
     Полосы прижаты к низу карточки отдельным слоем — скругление пилюли
     не срезается переполнением столбика. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_bento_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <ImageView
        android:id="@+id/widget_bento_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bento_bg"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:weightSum="100">

        <FrameLayout
            android:id="@+id/widget_bento_steps_card"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="48"
            android:layout_marginEnd="6dp">

            <TextView
                android:id="@+id/widget_bento_steps_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_marginStart="10dp"
                android:layout_marginTop="6dp"
                android:text="Шаги"
                android:textColor="#8E95A2"
                android:textSize="12sp"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false" />

            <FrameLayout
                android:layout_width="92dp"
                android:layout_height="92dp"
                android:layout_gravity="center"
                android:layout_marginBottom="14dp">

                <ProgressBar
                    android:id="@+id/widget_bento_steps_ring"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:max="100"
                    android:progress="0"
                    android:indeterminate="false"
                    android:progressDrawable="@drawable/fitflow_bento_ring" />

                <ImageView
                    android:id="@+id/widget_bento_steps_icon"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_gravity="center"
                    android:scaleType="fitCenter"
                    android:src="@drawable/widget_bento_sneaker"
                    android:contentDescription="@null" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingBottom="4dp">

                <TextView
                    android:id="@+id/widget_bento_steps_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/widget_bento_steps_goal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="из 0"
                    android:textColor="#8E95A2"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif"
                    android:includeFontPadding="false"
                    android:maxLines="1" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="52"
            android:orientation="vertical"
            android:weightSum="100">

            <FrameLayout
                android:id="@+id/widget_bento_water_card"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="50">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="10dp"
                    android:paddingEnd="58dp"
                    android:paddingTop="6dp">

                    <TextView
                        android:id="@+id/widget_bento_water_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Вода"
                        android:textColor="#8E95A2"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif"
                        android:includeFontPadding="false"
                        android:maxLines="1" />

                    <TextView
                        android:id="@+id/widget_bento_water_value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="0"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/widget_bento_water_goal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="из 0 мл"
                        android:textColor="#8E95A2"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/widget_bento_water_bar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="12dp"
                    android:layout_gravity="bottom"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="58dp"
                    android:layout_marginBottom="10dp"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/fitflow_bento_bar_water" />

                <TextView
                    android:id="@+id/widget_bento_water_btn"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/fitflow_bento_btn"
                    android:gravity="center"
                    android:text="+250\nмл"
                    android:textColor="#082028"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="0dp"
                    android:maxLines="2"
                    android:contentDescription="+250 мл" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/widget_bento_food_card"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="50">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="10dp"
                    android:paddingEnd="58dp"
                    android:paddingTop="6dp">

                    <TextView
                        android:id="@+id/widget_bento_food_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Калории"
                        android:textColor="#8E95A2"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif"
                        android:includeFontPadding="false"
                        android:maxLines="1" />

                    <TextView
                        android:id="@+id/widget_bento_food_value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="0"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/widget_bento_food_goal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="из 0 ккал"
                        android:textColor="#8E95A2"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/widget_bento_food_bar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="12dp"
                    android:layout_gravity="bottom"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="58dp"
                    android:layout_marginBottom="10dp"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/fitflow_bento_bar_food" />

                <TextView
                    android:id="@+id/widget_bento_food_btn"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/fitflow_bento_btn_food"
                    android:gravity="center"
                    android:text="✎"
                    android:textColor="#2B1009"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:contentDescription="Записать еду" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
